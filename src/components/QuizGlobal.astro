---
// Global Quiz component that works in all markdown files
---

<script>
// Global quiz functionality
window.createQuiz = function(containerId, question, options, correctAnswer, explanation) {
    setTimeout(() => {
        const container = document.getElementById(containerId);
        if (!container) return;
        
        container.innerHTML = `
            <div class="quiz-container bg-gradient-to-br from-blue-500/10 to-purple-500/10 rounded-2xl p-6 border border-blue-500/20 my-6">
                <h3 class="text-lg font-bold text-white mb-4 flex items-center">
                    <svg class="w-5 h-5 mr-2 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                    </svg>
                    Quiz Question
                </h3>
                
                <p class="text-gray-200 mb-6 text-lg leading-relaxed">${question}</p>
                
                <div class="space-y-3 quiz-options">
                    ${options.map((option, index) => `
                        <button class="quiz-option w-full p-4 text-left bg-white/5 hover:bg-white/10 border border-gray-600/30 hover:border-gray-500/50 rounded-xl transition-all duration-300 text-gray-200 hover:text-white" data-option="${index}">
                            <div class="flex items-center">
                                <div class="w-6 h-6 rounded-full border-2 border-gray-400 mr-3 flex items-center justify-center text-sm font-bold">
                                    ${String.fromCharCode(65 + index)}
                                </div>
                                ${option}
                            </div>
                        </button>
                    `).join('')}
                </div>
                
                <div class="quiz-feedback mt-4 p-4 rounded-xl" style="display: none;">
                    <div class="feedback-content"></div>
                    ${explanation ? `
                        <div class="explanation mt-3 p-3 bg-blue-500/10 rounded-lg border border-blue-500/20">
                            <p class="text-sm text-blue-200">
                                <strong>Explanation:</strong> ${explanation}
                            </p>
                        </div>
                    ` : ''}
                </div>
            </div>
        `;
        
        const options_elements = container.querySelectorAll('.quiz-option');
        const feedback = container.querySelector('.quiz-feedback');
        const feedbackContent = container.querySelector('.feedback-content');
        let answered = false;
        
        options_elements.forEach((option) => {
            option.addEventListener('click', () => {
                if (answered) return;
                
                answered = true;
                const selectedIndex = parseInt(option.dataset.option);
                
                options_elements.forEach(opt => {
                    opt.style.pointerEvents = 'none';
                    const optIndex = parseInt(opt.dataset.option);
                    
                    if (optIndex === correctAnswer) {
                        opt.style.backgroundColor = 'rgba(34, 197, 94, 0.5)';
                        opt.style.borderColor = '#22c55e';
                        opt.style.color = '#bbf7d0';
                    } else if (optIndex === selectedIndex) {
                        opt.style.backgroundColor = 'rgba(239, 68, 68, 0.5)';
                        opt.style.borderColor = '#ef4444';
                        opt.style.color = '#fecaca';
                    } else {
                        opt.style.opacity = '0.5';
                    }
                });
                
                const isCorrect = selectedIndex === correctAnswer;
                feedbackContent.innerHTML = isCorrect 
                    ? '<div style="display: flex; align-items: center; color: #4ade80;"><svg style="width: 20px; height: 20px; margin-right: 8px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg><strong>Correct!</strong> Well done.</div>'
                    : '<div style="display: flex; align-items: center; color: #f87171;"><svg style="width: 20px; height: 20px; margin-right: 8px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg><strong>Incorrect.</strong> Try again next time.</div>';
                
                feedback.style.display = 'block';
            });
        });
    }, 100);
};
</script>