---
interface Props {
    idiom: string;
    meaning: string;
    example?: string;
    bgColor: string;
    textColor?: string;
    size?: 'small' | 'medium' | 'large';
}

const { idiom, meaning, example, bgColor, textColor = 'text-slate-900', size = 'medium' } = Astro.props;

const sizeClasses = {
    small: 'text-sm md:text-base',
    medium: 'text-base md:text-lg',
    large: 'text-lg md:text-xl'
};
---

<div class={`group ${bgColor} rounded-2xl p-4 flex flex-col justify-center items-center text-center transition-all duration-300 hover:scale-105 cursor-pointer shadow-lg hover:shadow-xl h-full ${sizeClasses[size]}`}>
    <!-- Idiom text (visible by default) -->
    <div class="group-hover:opacity-0 transition-opacity duration-300">
        <h3 class={`font-bold ${textColor} leading-tight`}>
            "{idiom}"
        </h3>
    </div>
    
    <!-- Meaning and example (visible on hover) -->
    <div class="absolute inset-0 p-4 flex flex-col justify-center items-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        <div class="text-center">
            <p class={`font-semibold mb-2 ${textColor} text-sm md:text-base`}>
                <span class="text-xs opacity-75">Means:</span><br />
                {meaning}
            </p>
            {example && (
                <p class={`text-xs md:text-sm italic opacity-90 ${textColor}`}>
                    "{example}"
                </p>
            )}
        </div>
    </div>
    

</div>