---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const post = await getCollection('post');
---

<Layout title='Learn English'>
    <header class='flex flex-col items-center pt-10'>
        <h1 class='text-7xl font-semibold text-center drop-shadow-md'>
            Welcome to learn <span
                class='text-transparent font-bold bg-clip-text bg-gradient-to-l from-cyan-500 to-sky-500'
                >English Blogs</span
            >!
        </h1>
        <p class='p-5 font-semibold text-center'>
            In this blog you can refresh your knowledge about the level
        </p>
    </header>
    <main>
        <section>
            <h2 class='text-2xl font-bold text-white mb-6'>Latest Posts</h2>
            <div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6'>
                {
                    post.map((post) => {
                        const { slug, data } = post;
                        const { title, description, img, tags } = data;
                        return (
                            <article class='flex flex-col shadow-lg overflow-hidden'>
                                <a href={`/post/${slug}`}>
                                    <img
                                        class='w-full h-48 object-contain'
                                        src={`/${img}`}
                                        alt={title}
                                        transition:name={`img-${slug}`}
                                    />
                                    <div class='p-6 flex flex-col justify-center items-center '>
                                        <h2
                                            class='text-2xl md:text-4xl font-bold text-white mb-2'
                                            transition:name={`title-${slug}`}
                                        >
                                            {title}
                                        </h2>
                                        <div class='flex flex-wrap gap-2 mb-4'>
                                            {tags.map((tag: any) => (
                                                <span class='bg-blue-500 text-white px-3 py-1 rounded-full text-sm'>
                                                    {tag}
                                                </span>
                                            ))}
                                        </div>
                                        <p class='text-gray-300 line-clamp-3 md:line-clamp-none'>
                                            {description}
                                        </p>
                                    </div>
                                </a>
                            </article>
                        );
                    })
                }
            </div>
        </section>
        <section class='w-full h-100'>
            <h2 class='text-2xl font-bold text-white mb-6'>Idioms</h2>
            <div class='h-90 w-full grid grid-cols-5 grid-rows-5 gap-4 p-1.5'>
                <div class='group bg-squirtle rounded-3xl col-span-2 row-span-5 text-center items-center flex justify-center trasition duration-300 ease-in-out hover:scale-105 hover:translate-y-1-'>
                    <span class='text-7xl inline-block font-bold rotate-6 text-black group-hover:invisible ease-in-out duration-300'
                        >Hit the nail on the head</span>
                    <p class="invisible group-hover:visible">means: </p>
                </div>
                <div class='bg-squirtle-dark col-span-2 rounded-2xl row-span-3 col-start-3 p-1 text-center items-center flex justify-center group-hover:invisible'>
                    <span class='text-7xl inline-block font-bold rotate-6 text-black'
                        >break a leg</span>
                </div>
                <div class='bg-sky-600 rounded-2xl row-span-5 col-start-5 text-center justify-center'>
                    <span class='text-7xl inline-block font-bold text-black '>to be on cloud nine</span>

                    </span>
                </div>
                <div
                    class='bg-sky-800 rounded-2xl col-span-2 row-span-2 col-start-3 row-start-4 p-3 text-center items-center flex justify-center hover:transition-all hover:scale-105'
                >
                    <span class='text-6xl inline-block font-bold overflow-hidden text-black'> to spill the beans </span>
                </div>
            </div>
        </section>
    </main>
</Layout>
